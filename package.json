{
  "name": "drishtikit-workspace",
  "private": true,
  "description": "Drishtikit: usage recording for NestJS and Angular apps.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/mongo",
    "packages/nest",
    "packages/browser",
    "packages/angular",
    "examples/nest-api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "build": "npm run build --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.5",
    "eventemitter2": "^6.4.9",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^26.1.0",
    "mongodb": "^6.22.0",
    "mongodb-memory-server": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0"
  }
}
