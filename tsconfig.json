{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "jest"],
    "paths": { "@drishtikit/*": ["./packages/*/src/index.ts"] }
  },
  "include": [
    "packages/core/src", "packages/core/test",
    "packages/mongo/src", "packages/mongo/test",
    "packages/nest/src", "packages/nest/test",
    "packages/browser/src", "packages/browser/test",
    "examples/nest-api/src", "examples/nest-api/test"
  ]
}
